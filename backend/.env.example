# Groq API key - get one at https://console.groq.com/keys
GROQ_API_KEY=

# ASR model used for transcription (must be a valid Groq-hosted Whisper model)
ASR_MODEL=whisper-large-v3-turbo

# LLM used for meeting analysis (must be a valid Groq-hosted chat model)
LLM_MODEL=openai/gpt-oss-20b

# SQLite database location (relative to backend/ when run locally)
DATABASE_URL=sqlite:///./meeting_summarizer.db

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max upload size in megabytes
MAX_UPLOAD_MB=25
